{
  "id": null,
  "uid": "autotrader-binance",
  "title": "Fricktrade Overview - Binance",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "timezone": "browser",
  "panels": [
    {
      "type": "stat",
      "title": "Binance Connectivity",
      "description": "Total successful API calls to Binance. Non-zero = connected.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(broker_requests_total{broker=\"binance\", status=\"success\"})",
          "legendFormat": "calls ok",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "API Errors (1h)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(broker_requests_total{broker=\"binance\", status=\"error\"}[1h]))",
          "legendFormat": "errors",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Trades Total",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(trades_by_broker_total{broker=\"binance\"})",
          "legendFormat": "binance",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "type": "stat",
      "title": "Total Equity (USDT)",
      "gridPos": {
        "x": 4,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "expr": "account_total_by_broker{broker=\"binance\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "type": "stat",
      "title": "Buying Power (USDT free)",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "expr": "account_buying_power_by_broker{broker=\"binance\"}",
          "legendFormat": "{{broker}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "type": "stat",
      "title": "Available Cash (USDT)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "expr": "account_cash_by_broker{broker=\"binance\"}",
          "legendFormat": "{{broker}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "type": "stat",
      "title": "Invested",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "expr": "clamp_min(account_invested_by_broker{broker=\"binance\"}, 0)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "type": "stat",
      "title": "Active Symbols",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "count(symbol_active_by_broker{broker=\"binance\"} == 1)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "type": "table",
      "title": "Active Strategies",
      "gridPos": {
        "x": 6,
        "y": 9,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "strategy_active",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Symbols Traded",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "symbol_active_by_broker{broker=\"binance\"} == 1",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Strategy Selections",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (strategy) (orchestrator_strategy_selected_total)",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Trades by Symbol/Side",
      "gridPos": {
        "x": 6,
        "y": 14,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (symbol, side) (trades_by_broker_total{broker=\"binance\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Trades Rate (5m)",
      "gridPos": {
        "x": 18,
        "y": 14,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (symbol, side) (rate(trades_by_broker_total{broker=\"binance\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Cumulative Trades by Symbol",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (symbol) (trades_by_broker_total{broker=\"binance\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "PnL % / Drawdown %",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pnl_percent_by_broker{broker=\"binance\"}",
          "legendFormat": "PnL%",
          "refId": "A"
        },
        {
          "expr": "drawdown_percent_by_broker{broker=\"binance\"}",
          "legendFormat": "Drawdown%",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Skipped Orders Rate (5m)",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(orders_skipped_by_broker_total{broker=\"binance\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Open Orders",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (symbol, side) (open_orders_by_broker{broker=\"binance\"})",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Current Portfolio",
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "position_qty_by_broker{broker=\"binance\"}",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "position_value_by_broker{broker=\"binance\"}",
          "refId": "B",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "symbol",
            "mode": "outer"
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Pending Orders",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "open_orders_by_broker{broker=\"binance\"}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Binance API Calls (1m)",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (method, status) (increase(broker_requests_total{broker=\"binance\"}[1m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 30
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Binance API Latency (p99, 5m)",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (method, le) (rate(broker_latency_seconds_bucket{broker=\"binance\"}[5m])))",
          "legendFormat": "p99 {{method}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (method, le) (rate(broker_latency_seconds_bucket{broker=\"binance\"}[5m])))",
          "legendFormat": "p50 {{method}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      }
    }
  ]
}
