{
  "id": null,
  "uid": "autotrader-binance",
  "title": "Fricktrade Overview - Binance",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "timezone": "browser",
  "panels": [
    {
      "type": "table",
      "title": "Broker Market Status",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "expr": "broker_market_open{broker=\"binance\"}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": "closed",
                "1": "open"
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Connectivity",
      "description": "Total successful API calls. Non-zero = connected.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(broker_requests_total{broker=\"binance\", status=\"success\"})",
          "legendFormat": "calls ok",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "API Errors (1h)",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(broker_requests_total{broker=\"binance\", status=\"error\"}[1h]))",
          "legendFormat": "errors",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Trades Total",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(trades_by_broker_total{broker=\"binance\"})",
          "legendFormat": "binance",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Total Equity",
      "gridPos": {
        "x": 4,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "expr": "account_total_by_broker{broker=\"binance\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "type": "stat",
      "title": "Buying Power",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "expr": "account_buying_power_by_broker{broker=\"binance\"}",
          "legendFormat": "{{broker}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "type": "stat",
      "title": "Available Cash (USDT)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "expr": "account_cash_by_broker{broker=\"binance\"}",
          "legendFormat": "{{broker}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "type": "stat",
      "title": "Invested",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "expr": "clamp_min(account_invested_by_broker{broker=\"binance\"}, 0)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "type": "stat",
      "title": "Active Symbols",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "count(symbol_active_by_broker{broker=\"binance\"} == 1)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "table",
      "title": "Active Strategies",
      "gridPos": {
        "x": 6,
        "y": 9,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "strategy_active",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Symbols Traded",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "symbol_active_by_broker{broker=\"binance\"} == 1",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Strategy Selections",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (strategy) (orchestrator_strategy_selected_total)",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Trades by Symbol/Side",
      "gridPos": {
        "x": 6,
        "y": 14,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (symbol, side) (trades_by_broker_total{broker=\"binance\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Trades Rate (5m)",
      "gridPos": {
        "x": 18,
        "y": 14,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (symbol, side) (rate(trades_by_broker_total{broker=\"binance\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Cumulative Trades by Symbol",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (symbol) (trades_by_broker_total{broker=\"binance\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "PnL % / Drawdown %",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pnl_percent_by_broker{broker=\"binance\"}",
          "legendFormat": "PnL%",
          "refId": "A"
        },
        {
          "expr": "drawdown_percent_by_broker{broker=\"binance\"}",
          "legendFormat": "Drawdown%",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Skipped Orders Rate (5m)",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(orders_skipped_by_broker_total{broker=\"binance\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Open Orders",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (symbol, side) (open_orders_by_broker{broker=\"binance\"})",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Active Broker",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "broker_active{broker=\"binance\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Orchestrator Strategies",
      "gridPos": {
        "x": 6,
        "y": 34,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "orchestrator_strategy_active",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Current Portfolio",
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "position_qty_by_broker{broker=\"binance\"}",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "position_value_by_broker{broker=\"binance\"}",
          "refId": "B",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "symbol",
            "mode": "outer"
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Pending Orders",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "open_orders_by_broker{broker=\"binance\"}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Broker API Calls (1m)",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (broker, method, status) (increase(broker_requests_total{broker=\"binance\"}[1m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "axisPlacement": "auto",
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 30
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Signal Metrics % (Latest)",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "signal_return_30m_pct",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "signal_return_60m_pct",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "signal_early_volume_pct",
          "refId": "C",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "signal_runup_pct",
          "refId": "D",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "signal_drawdown_pct",
          "refId": "E",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "symbol",
            "mode": "outer"
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Signal Metrics Abs (Latest)",
      "gridPos": {
        "x": 12,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "signal_abs_move",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "signal_runup_abs",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "signal_drawdown_abs",
          "refId": "C",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "symbol",
            "mode": "outer"
          }
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Entry Ranking Scores (Live)",
      "gridPos": {
        "x": 0,
        "y": 58,
        "w": 18,
        "h": 8
      },
      "targets": [
        {
          "expr": "entry_ranking_score{broker=\"binance\"}",
          "refId": "A",
          "instant": true,
          "legendFormat": "{{symbol}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10,
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-blue",
                "value": null
              },
              {
                "color": "blue",
                "value": 0.2
              },
              {
                "color": "green",
                "value": 0.4
              },
              {
                "color": "yellow",
                "value": 0.6
              },
              {
                "color": "orange",
                "value": 0.8
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "gauge",
      "title": "Market Sentiment (Ollama Aggregate)",
      "gridPos": {
        "x": 18,
        "y": 58,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "market_sentiment_score{broker=\"binance\"}",
          "refId": "A",
          "instant": true,
          "legendFormat": "sentiment"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "text": {}
      },
      "fieldConfig": {
        "defaults": {
          "min": -1,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": -0.3
              },
              {
                "color": "yellow",
                "value": -0.1
              },
              {
                "color": "green",
                "value": 0.1
              },
              {
                "color": "dark-green",
                "value": 0.3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "decimals": 2
        },
        "overrides": []
      }
    }
  ]
}
