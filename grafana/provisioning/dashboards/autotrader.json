{
  "id": null,
  "uid": "autotrader",
  "title": "Autotrader Overview",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "timezone": "browser",
  "panels": [
    {
      "type": "stat",
      "title": "Trades Total",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(trades_total)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Total Equity",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "account_total",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "type": "stat",
      "title": "Available Cash",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "account_cash",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "type": "stat",
      "title": "Invested",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "account_invested",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "type": "stat",
      "title": "Active Symbols",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "count(symbol_active)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "table",
      "title": "Active Strategies",
      "gridPos": {
        "x": 6,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "strategy_active",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Symbols Traded",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "symbol_active",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Trades by Symbol/Side",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (symbol, side) (trades_total)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Trades Rate (5m)",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (symbol, side) (rate(trades_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Cumulative Trades by Symbol",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (symbol) (trades_total)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "PnL % / Drawdown %",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "pnl_percent",
          "refId": "A"
        },
        {
          "expr": "drawdown_percent",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Skipped Orders Rate (5m)",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(orders_skipped_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Open Orders",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (symbol, side) (open_orders)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Active Broker",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "broker_active",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Orchestrator Strategies",
      "gridPos": {
        "x": 6,
        "y": 30,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "orchestrator_strategy_active",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Current Portfolio",
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "position_qty",
          "refId": "A"
        },
        {
          "expr": "position_value",
          "refId": "B"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "symbol",
            "mode": "outer"
          }
        }
      ]
    },
    {
      "type": "table",
      "title": "Pending Orders",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "open_orders",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    }
  ]
}