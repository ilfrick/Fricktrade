{
  "id": null,
  "uid": "autotrader-performance",
  "title": "Fricktrade Performance",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "panels": [
    {
      "type": "table",
      "title": "Strategy Performance (Rolling)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "strategy_win_rate",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "strategy_avg_pnl_pct",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "strategy_drawdown_pct",
          "refId": "C",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "strategy_trades_realized_total",
          "refId": "D",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "strategy_disabled",
          "refId": "E",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "strategy",
            "mode": "outer"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Disabled Strategies",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(strategy_disabled)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Trades Realized (24h)",
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(strategy_trades_realized_total[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    }
  ]
}
