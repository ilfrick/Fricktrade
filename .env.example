ALPACA_API_KEY=
ALPACA_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Binance demo endpoint: spot demo = https://demo-api.binance.com, futures demo = https://demo-fapi.binance.com
# Leave blank for live trading
BINANCE_BASE_URL=https://demo-api.binance.com
IBKR_ACCOUNT=
IBKR_CURRENCY=
# Required when api.auth.enabled is true (the shipped default). The control API can
# rewrite config.yaml and restart the stack; with this empty it refuses requests (500)
# instead of allowing them. Generate one with:  openssl rand -hex 32
FRICKTRADE_API_TOKEN=
# If blank, OpenCode uses FRICKTRADE_API_TOKEN as its internal service password.
OPENCODE_SERVER_PASSWORD=
TRADING_MODE=paper
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
# Optional: override the Docker-network default used by the `ollama` LLM backend.
OLLAMA_BASE_URL=http://ollama:11434
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
COINGLASS_API_KEY=
GRAFANA_PASSWORD=admin
KILL_SWITCH_CODE=
ALERTMANAGER_SMTP_SMARTHOST=
ALERTMANAGER_SMTP_FROM=
ALERTMANAGER_SMTP_USERNAME=
ALERTMANAGER_SMTP_PASSWORD=
ALERTMANAGER_SMTP_REQUIRE_TLS=true
ALERTMANAGER_SMTP_HELLO=
ALERTMANAGER_EMAIL_TO=
